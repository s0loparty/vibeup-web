{
  "name": "msg-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "prepare": "husky",
    "generate": "npx @hey-api/openapi-ts -i http://localhost/docs/api-docs.yaml -o ./src/shared/api -c @hey-api/client-axios"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@hey-api/client-axios": "^0.9.1",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/vue-query": "^5.96.0",
    "@tanstack/vue-query-devtools": "^6.1.13",
    "@twallpaper/vue": "^2.1.2",
    "@vue/compiler-sfc": "^3.5.31",
    "@vueuse/core": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.31",
    "vue-frimousse": "^0.1.4",
    "vue-router": "^5.0.4",
    "vue-routes-to-types": "^0.3.8",
    "vue-sonner": "^2.0.9",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.95.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.0",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.5",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-component-type-helpers": "^3.2.6",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix"
    ]
  }
}
